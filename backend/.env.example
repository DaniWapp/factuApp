# =====================================================================
# Archivo:  backend/.env.example
# Proyecto: FacturApp (backend)
#
# Qué es:
#   La plantilla del archivo .env: los mismos nombres de variables, pero
#   con valores de ejemplo. Este archivo SÍ se sube a GitHub; el .env con
#   los valores reales NO (contiene contraseñas y claves).
#
# Cómo se usa:
#   1. Copie este archivo y llame a la copia ".env" (en la misma carpeta).
#   2. Cambie los valores por los de su equipo.
# =====================================================================

# --- Base de datos (MySQL de AppServ o MariaDB de XAMPP) ---
# Dirección y puerto del servidor de base de datos.
DB_HOST=127.0.0.1
DB_PORT=3306
# Nombre de la base de datos que crea database/schema.sql.
DB_NAME=facturapp
# Usuario y contraseña de MySQL. Use un usuario propio del proyecto, no root.
DB_USER=facturapp
DB_PASSWORD=cambia-esto

# --- Tokens JWT del inicio de sesión ---
# Clave con la que la API firma los tokens. Debe ser larga y aleatoria;
# quien la conozca podría fabricar tokens falsos. Para generar una:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_CLAVE_SECRETA=cambia-esto-por-una-clave-larga-y-aleatoria
# Algoritmo de firma del token.
JWT_ALGORITMO=HS256
# Minutos que dura un token (480 = 8 horas, una jornada).
JWT_MINUTOS_VIGENCIA=480

# --- API ---
# Puerto donde se ejecuta la API.
API_PUERTO=8000
# Hora de Colombia para fechas y horas (RNF-32).
ZONA_HORARIA=America/Bogota
# true solo en desarrollo: muestra detalles técnicos de los errores.
MODO_DEPURACION=false
